# Database
DATABASE_URL=postgresql://user:password@host:port/database

# Session
SESSION_SECRET=your-session-secret-here

# AI (OpenRouter)
GEMINI_API_KEY=sk-or-v1-your-openrouter-api-key

# Optional: Custom AI models
# OPENROUTER_MODEL=amazon/nova-lite-v1
# OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-exp:free

# Admin Credentials (for seeding admin user)
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_SECRET=your-admin-promotion-secret

# Server (for deployment workflow - keep in GitHub Secrets)
# EC2_HOST=your-ec2-ip-address
# SSH_KEY=your-ssh-private-key
